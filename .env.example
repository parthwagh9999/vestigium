# ============================================
# VESTIGIUM — Environment Configuration
# ============================================
# Copy this file to .env and customize values.

# ---- Application ----
APP_NAME=VESTIGIUM
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Database ----
# SQLite (default — no setup required)
DATABASE_URL=sqlite+aiosqlite:///./vestigium.db

# PostgreSQL (optional — uncomment to use)
# DATABASE_URL=postgresql+asyncpg://vestigium:vestigium@localhost:5432/vestigium

# ---- Authentication ----
JWT_SECRET_KEY=change-me-to-another-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Redis (optional) ----
# Leave empty to use in-memory task queue fallback
REDIS_URL=

# ---- Celery (optional — requires Redis) ----
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ---- File Storage ----
UPLOAD_DIR=./uploads
BACKUP_DIR=./backups
MAX_UPLOAD_SIZE_MB=100

# ---- Encryption ----
# Fernet key for encrypting API keys in vault
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ---- Rate Limiting ----
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_BURST=20

# ---- Logging ----
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---- AI Features (optional) ----
# Ollama (local LLM — recommended for offline)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# OpenAI-compatible API (optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4

# ---- Plugin System ----
PLUGIN_DIR=./plugins
PLUGIN_MARKETPLACE_URL=

# ---- Backup ----
AUTO_BACKUP_ENABLED=true
AUTO_BACKUP_INTERVAL_HOURS=6
AUTO_BACKUP_RETENTION_DAYS=30
